PORT=5001
DATABASE_URL="your-postgresql-connection-string"

# ==============================================================================
# EMAIL CONFIGURATION & DELIVERABILITY GUIDE
#
# WHY EMAILS GO TO JUNK / FAIL DELIVERY:
# Sending emails from a "@gmail.com" address via third-party services like
# SendGrid fails DMARC / SPF authentication on Gmail, Outlook, Yahoo, and
# corporate mail servers (like carfinancego.co.uk).
#
# Choose ONE of the two solutions below for 100% inbox delivery:
#
# --- OPTION 1: SENDGRID WITH BRANDED DOMAIN (RECOMMENDED) ---
# 1. In SendGrid Dashboard: Go to Settings -> Sender Authentication -> Authenticate Domain.
# 2. Add domain "vancarautos.co.uk" and add the 3 CNAME DNS records to your DNS provider.
# 3. Set SENDGRID_FROM_EMAIL to a domain address (e.g. noreply@vancarautos.co.uk).
# 4. Set REPLY_TO_EMAIL to your Gmail (hellovancarautos@gmail.com) so replies reach you.
#
# --- OPTION 2: GMAIL DIRECT SMTP WITH GOOGLE APP PASSWORD ---
# 1. Enable 2-Step Verification on hellovancarautos@gmail.com
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create a 16-character App Password (e.g. "abcd efgh ijkl mnop")
# 4. Paste it into SMTP_PASS below and set EMAIL_PROVIDER="smtp"
# (Gmail directly signs SPF and DKIM with 100% inbox delivery)
# ==============================================================================

# Preferred Provider: 'sendgrid' (default) or 'smtp'
EMAIL_PROVIDER=sendgrid

# SendGrid Configuration
SENDGRID_API_KEY="your-sendgrid-api-key"
# For best deliverability, use a verified domain address (e.g. noreply@vancarautos.co.uk or finance@vancarautos.co.uk)
SENDGRID_FROM_EMAIL="noreply@vancarautos.co.uk"
SENDGRID_FROM_NAME="Vancar Autos"
REPLY_TO_EMAIL="hellovancarautos@gmail.com"

# SMTP Configuration (Used as automatic fallback or primary if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="hellovancarautos@gmail.com"
SMTP_PASS="your-16-char-gmail-app-password"
SMTP_FROM="Vancar Autos <hellovancarautos@gmail.com>"

# Recipient Endpoints
CONTACT_EMAIL_RECIPIENT="hellovancarautos@gmail.com"
FINANCE_EMAIL_RECIPIENT_1="hellovancarautos@gmail.com"
FINANCE_EMAIL_RECIPIENT_2="tariq@carfinancego.co.uk"

# Finance & Security
FINANCE_ENCRYPTION_KEY="your-strong-random-encryption-key-32-chars"
ADMIN_PORTAL_URL="https://vancarautos.co.uk/admin/finance-applications"

# Finance Illustrative APR Rates (% - optional overrides)
FINANCE_APR_EXCELLENT=11.9
FINANCE_APR_GOOD=12.9
FINANCE_APR_FAIR=13.9
FINANCE_APR_POOR=19.9
FINANCE_APR_BAD=19.9

# Auto Trader API Integration Settings
AUTOTRADER_KEY="your-key"
AUTOTRADER_SECRET="your-secret"
AUTOTRADER_ADVERTISER_ID="your-advertiser-id"
AUTOTRADER_BASE_URL="https://api.autotrader.co.uk"
